# Cadena de conexion a PostgreSQL (Neon, Supabase, local, etc.)
# Local:    postgresql://postgres:postgres@localhost:5432/itsio
# Neon:     postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/itsio?sslmode=require
DATABASE_URL=postgresql://usuario:password@localhost:5432/itsio

# Puerto del servidor API (opcional, por defecto 3001)
API_PORT=3001

# URL de la API para el frontend (opcional; vacio usa el proxy de Vite)
# VITE_API_URL=http://localhost:3001
