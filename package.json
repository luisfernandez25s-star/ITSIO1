{
  "name": "itsio-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n API,WEB -c green,cyan \"node server/index.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
